{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Maestri extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/integrations/vscode"],
      "outFiles": ["${workspaceFolder}/integrations/vscode/dist/**/*.cjs"],
      "preLaunchTask": "build:vscode"
    }
  ]
}
